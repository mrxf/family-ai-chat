# ==========================================
# 小暖 (Nuan) 服务端环境变量配置示例
# 复制为 .env 后按需填写：cp .env.example .env
# ==========================================

# HTTP 监听地址（默认 :8080；若本机反代可设为 127.0.0.1:8080）
NUAN_ADDR=:8080

# 数据目录，存放 nuan.db、上传图片 files/、App 更新包 app/（默认 ./data）
NUAN_DATA_DIR=./data

# 日志输出格式：text 或 json（默认 text）
NUAN_LOG_FORMAT=text

# ------------------------------------------
# 首次启动初始化（仅在数据库对应表为空时生效，不会覆盖已有数据）
# ------------------------------------------

# 初始管理员用户名（默认 admin）
NUAN_ADMIN_USERNAME=admin

# 初始管理员密码（可选）。填了：首次启动自动创建管理员；留空：服务端打印一次性设置码（setup_code），
# 在 App 登录页填入服务器地址后按提示初始化
NUAN_ADMIN_PASSWORD=

# 默认 OpenAI 兼容上游地址（可选，与 NUAN_UPSTREAM_KEY 同时配置时首次启动导入为默认供应商，只导入一次，之后在 App 里管理）
# 只填域名会自动加 /v1；带路径的地址（如 /api/v1、/v1beta/openai）原样使用
# 示例：https://api.example.com/v1
NUAN_UPSTREAM_URL=

# 默认上游 API Key（留空则不导入，启动后在 App「设置 → 模型与供应商」里添加）
NUAN_UPSTREAM_KEY=

# 首次创建默认中转站时自动导入的模型 ID 列表，逗号分隔，第一个将设为默认模型（默认 gpt-6.1-terra）
NUAN_MODELS=gpt-6.1-terra

# ------------------------------------------
# 语音输入（可选，需同时配置 NUAN_ASR_URL 与 NUAN_ASR_KEY 才会开启）
# ------------------------------------------

# OpenAI 兼容语音转写接口地址（带不带 /v1 均可，实际请求 <URL>/v1/audio/transcriptions）
# 硅基流动示例：https://api.siliconflow.cn/v1
NUAN_ASR_URL=

# 语音转写服务 API Key
NUAN_ASR_KEY=

# 语音转写模型名（默认 FunAudioLLM/SenseVoiceSmall）
NUAN_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
